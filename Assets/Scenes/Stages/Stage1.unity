--- !u!114 &814165473
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 814165471}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e65d5cc5f011ca4459f87c81a2bbac93, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionType: 1
  eventDetect: {fileID: 0}
  dialogue:
    dialogueLines:
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: 92980fcff04640e42b8094973538d77f, type: 3}
      line: Ini benar lantai 3
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: f080a536dced39e479829767ba4b29c7, type: 3}
      line: Tapi berbeda... Ini bukan lantai 3 biasanya..
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: 92980fcff04640e42b8094973538d77f, type: 3}
      line: Ada yang salah.. Lalu lift ini... Untungnya menyala, tetapi...
    - character:
        name: 
        charIcon: {fileID: -2141453297, guid: ab41aab17783c8f439a05f8ef99e15b3, type: 3}
      line: BEEP!
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: c0ff2e9ea520d2544ad6135ec3e5e451, type: 3}
      line: Kenapa lift ini menolak ID card ku?!?
    - character:
        name: 
        charIcon: {fileID: -2141453297, guid: ab41aab17783c8f439a05f8ef99e15b3, type: 3}
      line: BEEP!
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: 7caded7bfe207f940aaaf792e46f1dec, type: 3}
      line: Apa sih...? Ayolah buka... buka...
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: 92980fcff04640e42b8094973538d77f, type: 3}
      line: ...Ugh, tidak mungkin.. Aku terjebak...?
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: f080a536dced39e479829767ba4b29c7, type: 3}
      line: Tidak! ...Aku harus keluar... Harus. Gimanapun Caranya.
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: d4b4d7ef5e61f1d4a8a7fbbf3b3d5e8a, type: 3}
      line: Mungkin jika ID card ku ini tidak berhasil... ID card staff yang jabatannya
        lebih tinggi bisa...
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: 43d90dd23a9f19348a7011b389c123d4, type: 3}
      line: 'Senior Mika... Kenapa tiba tiba dia ada dipikiranku? '
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: f080a536dced39e479829767ba4b29c7, type: 3}
      line: Dia selalu meninggalkan barang barangnya di mejanya... Tidak ada salahnya
        mencoba mencari...
