  eventDetect: {fileID: 0}
  dialogue:
    dialogueLines:
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: f080a536dced39e479829767ba4b29c7, type: 3}
      line: ...Kok... Gelap banget?
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: 92980fcff04640e42b8094973538d77f, type: 3}
      line: Dan sepi sekali...
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: f080a536dced39e479829767ba4b29c7, type: 3}
      line: ...Generator kantor gak pernah mati jam segini...
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: 92980fcff04640e42b8094973538d77f, type: 3}
      line: Aduh, hp ku juga kenapa mati sih...
    - character:
        name: Kino
        charIcon: {fileID: 21300000, guid: f080a536dced39e479829767ba4b29c7, type: 3}
      line: Aku harus keluar dari sini... Aku harap liftnya tetap menyala...
